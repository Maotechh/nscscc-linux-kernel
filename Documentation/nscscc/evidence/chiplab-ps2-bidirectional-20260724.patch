+    wire ps2_dat_line = ps2_dat_t && !device_dat_pd;
+
+    integer timeout;
+    reg [31:0] read_data;
+
+    always #5 clk = !clk;
+
+    chiplab_ps2_rx #(
+        .CLK_RATE(1000000)
+    ) dut (
+        .clk(clk),
+        .reset_n(reset_n),
+        .apb_addr(apb_addr),
+        .apb_psel(apb_psel),
+        .apb_penable(apb_penable),
+        .apb_pwrite(apb_pwrite),
+        .apb_pwdata(apb_pwdata),
+        .apb_prdata(apb_prdata),
+        .apb_pready(apb_pready),
+        .ps2_clk_i(ps2_clk_line),
+        .ps2_clk_o(ps2_clk_o),
+        .ps2_clk_t(ps2_clk_t),
+        .ps2_dat_i(ps2_dat_line),
+        .ps2_dat_o(ps2_dat_o),
+        .ps2_dat_t(ps2_dat_t),
+        .irq(irq)
+    );
+
+    ps2_echo_device device (
+        .ps2_clk_in(ps2_clk_line),
+        .ps2_clk_pd(device_clk_pd),
+        .ps2_dat_in(ps2_dat_line),
+        .ps2_dat_pd(device_dat_pd)
+    );
+
+    task apb_write;
+        input [19:0] address;
+        input [31:0] value;
+        begin
+            @(negedge clk);
+            apb_addr = address;
+            apb_pwdata = value;
+            apb_pwrite = 1'b1;
+            apb_psel = 1'b1;
+            apb_penable = 1'b0;
+            @(negedge clk);
+            apb_penable = 1'b1;
+            #1;
+            if (!apb_pready)
+                $fatal(1, "APB write did not complete");
+            @(negedge clk);
+            apb_psel = 1'b0;
+            apb_penable = 1'b0;
+            apb_pwrite = 1'b0;
+            apb_pwdata = 32'b0;
+        end
+    endtask
+
+    task apb_read;
+        input [19:0] address;
+        output [31:0] value;
+        begin
+            @(negedge clk);
+            apb_addr = address;
+            apb_pwrite = 1'b0;
+            apb_psel = 1'b1;
+            apb_penable = 1'b0;
+            @(negedge clk);
+            apb_penable = 1'b1;
+            #1;
+            if (!apb_pready)
+                $fatal(1, "APB read did not complete");
+            value = apb_prdata;
+            @(negedge clk);
+            apb_psel = 1'b0;
+            apb_penable = 1'b0;
+        end
+    endtask
+
+    initial begin
+        repeat (8) @(posedge clk);
+        reset_n = 1'b1;
+        repeat (8) @(posedge clk);
+
+        if (ps2_clk_o !== 1'b0 || ps2_dat_o !== 1'b0)
+            $fatal(1, "open-drain outputs must drive only zero");
+        if (ps2_clk_t !== 1'b1 || ps2_dat_t !== 1'b1)
+            $fatal(1, "PS/2 lines were not released after reset");
+
+        apb_write(20'h00004, 32'h00000001);
+        apb_write(20'h00000, 32'h000000ff);
+
+        timeout = 0;
+        while (irq !== 1'b1 && timeout < 100000) begin
+            @(posedge clk);
+            timeout = timeout + 1;
+        end
+        if (timeout == 100000)
+            $fatal(1, "timed out waiting for keyboard ACK");
+
+        apb_read(20'h00000, read_data);
+        if (read_data[31:16] !== 16'h0001)
+            $fatal(1, "RAVAIL was not one: %08x", read_data);
+        if (read_data[15] !== 1'b1)
+            $fatal(1, "RVALID was not set: %08x", read_data);
+        if (read_data[7:0] !== 8'hfa)
+            $fatal(1, "received byte was not ACK 0xfa: %08x", read_data);
+
+        repeat (4) @(posedge clk);
+        if (irq !== 1'b0)
+            $fatal(1, "IRQ remained asserted after ACK FIFO pop");
+
+        timeout = 0;
+        while (irq !== 1'b1 && timeout < 100000) begin
+            @(posedge clk);
+            timeout = timeout + 1;
+        end
+        if (timeout == 100000)
+            $fatal(1, "timed out waiting for keyboard BAT result");
+
+        apb_read(20'h00000, read_data);
+        if (read_data[31:16] !== 16'h0001)
+            $fatal(1, "BAT RAVAIL was not one: %08x", read_data);
+        if (read_data[15] !== 1'b1)
+            $fatal(1, "BAT RVALID was not set: %08x", read_data);
+        if (read_data[7:0] !== 8'haa)
+            $fatal(1, "received byte was not BAT 0xaa: %08x", read_data);
+
+        apb_read(20'h00000, read_data);
+        if (read_data[31:16] !== 16'h0000 ||
+            read_data[15] !== 1'b0)
+            $fatal(1, "FIFO was not empty after read: %08x", read_data);
+
+        $display("PASSED: keyboard reset, ACK/BAT RX, FIFO, and IRQ");
+        $finish;
+    end
+endmodule
+
+module ps2_echo_device (
+    input  wire ps2_clk_in,
+    output reg  ps2_clk_pd,
+    input  wire ps2_dat_in,
+    output reg  ps2_dat_pd
+);
+    localparam BITLEN = 500;
+
+    integer bit_number;
+    reg [15:0] data;
+
+    task send_byte;
+        input [7:0] value;
+        reg [9:0] frame;
+        begin
+            frame = {1'b1, ~^value, value};
+            ps2_dat_pd = 1'b1;
+            #15;
+            for (bit_number = 0; bit_number < 11;
+                 bit_number = bit_number + 1) begin
+                ps2_clk_pd = 1'b1;
+                #BITLEN;
+                ps2_clk_pd = 1'b0;
+                #16;
+                ps2_dat_pd = ~frame[0];
+                frame = {1'b1, frame[9:1]};
+                #BITLEN;
+                #15;
+            end
+        end
+    endtask
+
+    initial begin
+        ps2_clk_pd = 1'b0;
+        ps2_dat_pd = 1'b0;
+
+        forever begin
+            @(negedge ps2_clk_in);
+            @(posedge ps2_clk_in);
+
+            for (bit_number = 0; bit_number < 10;
+                 bit_number = bit_number + 1) begin
+                #BITLEN;
+                ps2_clk_pd = 1'b1;
+                #BITLEN;
+                ps2_clk_pd = 1'b0;
+                #1;
+                data = {ps2_dat_in, data[9:1]};
+            end
+
+            #BITLEN;
+            ps2_dat_pd = 1'b1;
+            #BITLEN;
+            ps2_clk_pd = 1'b1;
+            #BITLEN;
+            ps2_clk_pd = 1'b0;
+            ps2_dat_pd = 1'b0;
+
+            #(BITLEN * 123);
+
+            if (data[7:0] !== 8'hff)
+                $fatal(1, "host command was not keyboard reset: %02x",
+                       data[7:0]);
+
+            if (ps2_clk_in)
+                send_byte(8'hfa);
+            else
+                $fatal(1, "host did not release PS/2 clock after command");
+
+            #(BITLEN * 23);
+            if (ps2_clk_in)
+                send_byte(8'haa);
+            else
+                $fatal(1, "host inhibited PS/2 clock before BAT result");
+        end
+    end
+endmodule
