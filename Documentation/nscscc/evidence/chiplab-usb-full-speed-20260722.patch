diff --git a/IP/APB_DEV/USB/README.md b/IP/APB_DEV/USB/README.md
new file mode 100644
index 0000000..5499605
--- /dev/null
+++ b/IP/APB_DEV/USB/README.md
@@ -0,0 +1,17 @@
+# USB Full-Speed host integration
+
+The controller RTL in this directory is the NSCSCC/JIT-THU modification of
+UltraEmbedded's USB Full-Speed host. The upstream RTL reference is commit
+`81eb9f131dbb434a9047ae074fea5c31ef46ce5d` from
+`ultraembedded/core_usb_host`. The JIT-THU version adds the `USB_CTRL2`
+register at offset `0x24`, a software-controlled PHY reset, and fixes the AXI
+write ordering expected by its register block.
+
+`apb_usbh_bridge.v` is specific to this Chiplab integration. It transfers one
+APB request at a time between the 100 MHz uncore clock and the 60 MHz UTMI
+clock. Writes deliberately send AXI-Lite AW before W because the modified V0.5
+register block does not accept write data before the address.
+
+The controller is mapped at physical address `0x1fe0c000`. Its SoC interrupt
+input is `6`, corresponding to LoongArch CPU interrupt number `8` in the Linux
+device tree.
diff --git a/IP/APB_DEV/USB/apb_usbh_bridge.v b/IP/APB_DEV/USB/apb_usbh_bridge.v
new file mode 100644
index 0000000..7ce0258
--- /dev/null
+++ b/IP/APB_DEV/USB/apb_usbh_bridge.v
@@ -0,0 +1,213 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// One-outstanding-transaction APB to AXI-Lite bridge for the USB host.
+// APB runs on the SoC uncore clock while the USB controller runs on UTMI_clk.
+module apb_usbh_bridge (
+    input  wire        apb_clk,
+    input  wire        apb_resetn,
+    input  wire        apb_psel,
+    input  wire        apb_penable,
+    input  wire        apb_pwrite,
+    input  wire [19:0] apb_paddr,
+    input  wire [31:0] apb_pwdata,
+    output reg  [31:0] apb_prdata,
+    output wire        apb_pready,
+
+    input  wire        usb_clk,
+    input  wire        usb_resetn,
+    output wire [31:0] cfg_awaddr,
+    output wire        cfg_awvalid,
+    input  wire        cfg_awready,
+    output wire [31:0] cfg_wdata,
+    output wire [3:0]  cfg_wstrb,
+    output wire        cfg_wvalid,
+    input  wire        cfg_wready,
+    input  wire [1:0]  cfg_bresp,
+    input  wire        cfg_bvalid,
+    output wire        cfg_bready,
+    output wire [31:0] cfg_araddr,
+    output wire        cfg_arvalid,
+    input  wire        cfg_arready,
+    input  wire [31:0] cfg_rdata,
+    input  wire [1:0]  cfg_rresp,
+    input  wire        cfg_rvalid,
+    output wire        cfg_rready
+);
+
+localparam [1:0] APB_IDLE     = 2'd0;
+localparam [1:0] APB_WAIT     = 2'd1;
+localparam [1:0] APB_COMPLETE = 2'd2;
+
+localparam [2:0] USB_IDLE    = 3'd0;
+localparam [2:0] USB_WRITE_A = 3'd1;
+localparam [2:0] USB_WRITE_D = 3'd2;
+localparam [2:0] USB_WRITE_B = 3'd3;
+localparam [2:0] USB_READ_A  = 3'd4;
+localparam [2:0] USB_READ_D  = 3'd5;
+
+reg [1:0] apb_state;
+reg       request_toggle;
+reg       request_write;
+reg [31:0] request_addr;
+reg [31:0] request_data;
+
+(* ASYNC_REG = "TRUE" *) reg response_toggle_sync1;
+(* ASYNC_REG = "TRUE" *) reg response_toggle_sync2;
+reg response_toggle_seen;
+(* ASYNC_REG = "TRUE" *) reg [31:0] response_data_sync1;
+(* ASYNC_REG = "TRUE" *) reg [31:0] response_data_sync2;
+
+reg [2:0] usb_state;
+(* ASYNC_REG = "TRUE" *) reg request_toggle_sync1;
+(* ASYNC_REG = "TRUE" *) reg request_toggle_sync2;
+reg request_toggle_seen;
+(* ASYNC_REG = "TRUE" *) reg request_write_sync1;
+(* ASYNC_REG = "TRUE" *) reg request_write_sync2;
+(* ASYNC_REG = "TRUE" *) reg [31:0] request_addr_sync1;
+(* ASYNC_REG = "TRUE" *) reg [31:0] request_addr_sync2;
+(* ASYNC_REG = "TRUE" *) reg [31:0] request_data_sync1;
+(* ASYNC_REG = "TRUE" *) reg [31:0] request_data_sync2;
+
+reg        usb_request_write;
+reg [31:0] usb_request_addr;
+reg [31:0] usb_request_data;
+reg [31:0] response_data;
+reg        response_toggle;
+
+assign apb_pready = (apb_state == APB_COMPLETE);
+
+assign cfg_awaddr  = usb_request_addr;
+assign cfg_awvalid = (usb_state == USB_WRITE_A);
+assign cfg_wdata   = usb_request_data;
+assign cfg_wstrb   = 4'hf;
+assign cfg_wvalid  = (usb_state == USB_WRITE_D);
+assign cfg_bready  = (usb_state == USB_WRITE_B);
+assign cfg_araddr  = usb_request_addr;
+assign cfg_arvalid = (usb_state == USB_READ_A);
+assign cfg_rready  = (usb_state == USB_READ_D);
+
+// The response payload is held until the next USB-domain response. The toggle
+// arrives only after the payload has propagated through two APB-domain stages.
+always @(posedge apb_clk or negedge apb_resetn) begin
+    if (!apb_resetn) begin
+        apb_state            <= APB_IDLE;
+        request_toggle       <= 1'b0;
+        request_write        <= 1'b0;
+        request_addr         <= 32'b0;
+        request_data         <= 32'b0;
+        response_toggle_sync1 <= 1'b0;
+        response_toggle_sync2 <= 1'b0;
+        response_toggle_seen <= 1'b0;
+        response_data_sync1  <= 32'b0;
+        response_data_sync2  <= 32'b0;
+        apb_prdata            <= 32'b0;
+    end else begin
+        response_toggle_sync1 <= response_toggle;
+        response_toggle_sync2 <= response_toggle_sync1;
+        response_data_sync1   <= response_data;
+        response_data_sync2   <= response_data_sync1;
+
+        case (apb_state)
+        APB_IDLE: begin
+            if (apb_psel && apb_penable) begin
+                request_write  <= apb_pwrite;
+                request_addr   <= {12'b0, apb_paddr};
+                request_data   <= apb_pwdata;
+                request_toggle <= ~request_toggle;
+                apb_state      <= APB_WAIT;
+            end
+        end
+        APB_WAIT: begin
+            if (response_toggle_sync2 != response_toggle_seen) begin
+                response_toggle_seen <= response_toggle_sync2;
+                apb_prdata           <= response_data_sync2;
+                apb_state            <= APB_COMPLETE;
+            end
+        end
+        APB_COMPLETE: begin
+            apb_state <= APB_IDLE;
+        end
+        default: apb_state <= APB_IDLE;
+        endcase
+    end
+end
+
+// Only one command may be active. The modified V0.5 USB register block does
+// not accept W before AW, so write address and data use separate states.
+always @(posedge usb_clk or negedge usb_resetn) begin
+    if (!usb_resetn) begin
+        request_toggle_sync1 <= 1'b0;
+        request_toggle_sync2 <= 1'b0;
+        request_toggle_seen  <= 1'b0;
+        request_write_sync1  <= 1'b0;
+        request_write_sync2  <= 1'b0;
+        request_addr_sync1   <= 32'b0;
+        request_addr_sync2   <= 32'b0;
+        request_data_sync1   <= 32'b0;
+        request_data_sync2   <= 32'b0;
+        usb_request_write    <= 1'b0;
+        usb_request_addr     <= 32'b0;
+        usb_request_data     <= 32'b0;
+        response_data        <= 32'b0;
+        response_toggle      <= 1'b0;
+        usb_state            <= USB_IDLE;
+    end else begin
+        request_toggle_sync1 <= request_toggle;
+        request_toggle_sync2 <= request_toggle_sync1;
+        request_write_sync1  <= request_write;
+        request_write_sync2  <= request_write_sync1;
+        request_addr_sync1   <= request_addr;
+        request_addr_sync2   <= request_addr_sync1;
+        request_data_sync1   <= request_data;
+        request_data_sync2   <= request_data_sync1;
+
+        case (usb_state)
+        USB_IDLE: begin
+            if (request_toggle_sync2 != request_toggle_seen) begin
+                request_toggle_seen <= request_toggle_sync2;
+                usb_request_write   <= request_write_sync2;
+                usb_request_addr    <= request_addr_sync2;
+                usb_request_data    <= request_data_sync2;
+                if (request_write_sync2)
+                    usb_state <= USB_WRITE_A;
+                else
+                    usb_state <= USB_READ_A;
+            end
+        end
+        USB_WRITE_A: begin
+            if (cfg_awready)
+                usb_state <= USB_WRITE_D;
+        end
+        USB_WRITE_D: begin
+            if (cfg_wready)
+                usb_state <= USB_WRITE_B;
+        end
+        USB_WRITE_B: begin
+            if (cfg_bvalid) begin
+                response_data   <= {30'b0, cfg_bresp};
+                response_toggle <= ~response_toggle;
+                usb_state       <= USB_IDLE;
+            end
+        end
+        USB_READ_A: begin
+            if (cfg_arready)
+                usb_state <= USB_READ_D;
+        end
+        USB_READ_D: begin
+            if (cfg_rvalid) begin
+                response_data   <= cfg_rdata;
+                response_toggle <= ~response_toggle;
+                usb_state       <= USB_IDLE;
+            end
+        end
+        default: usb_state <= USB_IDLE;
+        endcase
+    end
+end
+
+// The current APB implementation has no PSLVERR signal. AXI-Lite responses
+// are still consumed so a peripheral-side error cannot stall the bus.
+wire unused_cfg_rresp = |cfg_rresp;
+wire unused_usb_request_write = usb_request_write;
+
+endmodule
diff --git a/IP/APB_DEV/USB/sim/apb_usbh_bridge_tb.v b/IP/APB_DEV/USB/sim/apb_usbh_bridge_tb.v
new file mode 100644
index 0000000..6b9438b
--- /dev/null
+++ b/IP/APB_DEV/USB/sim/apb_usbh_bridge_tb.v
@@ -0,0 +1,144 @@
+`timescale 1ns/1ps
+
+module apb_usbh_bridge_tb;
+reg apb_clk = 1'b0;
+reg usb_clk = 1'b0;
+reg apb_resetn = 1'b0;
+reg usb_resetn = 1'b0;
+reg apb_psel = 1'b0;
+reg apb_penable = 1'b0;
+reg apb_pwrite = 1'b0;
+reg [19:0] apb_paddr = 20'b0;
+reg [31:0] apb_pwdata = 32'b0;
+wire [31:0] apb_prdata;
+wire apb_pready;
+
+wire [31:0] cfg_awaddr;
+wire cfg_awvalid;
+wire cfg_awready;
+wire [31:0] cfg_wdata;
+wire [3:0] cfg_wstrb;
+wire cfg_wvalid;
+wire cfg_wready;
+reg [1:0] cfg_bresp = 2'b0;
+reg cfg_bvalid = 1'b0;
+wire cfg_bready;
+wire [31:0] cfg_araddr;
+wire cfg_arvalid;
+wire cfg_arready;
+reg [31:0] cfg_rdata = 32'b0;
+reg [1:0] cfg_rresp = 2'b0;
+reg cfg_rvalid = 1'b0;
+wire cfg_rready;
+
+reg [31:0] register_file [0:15];
+reg [31:0] accepted_awaddr;
+reg aw_seen = 1'b0;
+integer index;
+
+always #5 apb_clk = ~apb_clk;
+always #8.333 usb_clk = ~usb_clk;
+
+assign cfg_awready = cfg_awvalid && !aw_seen;
+assign cfg_wready = cfg_wvalid && aw_seen;
+assign cfg_arready = cfg_arvalid && !cfg_rvalid;
+
+apb_usbh_bridge dut (
+    .apb_clk(apb_clk), .apb_resetn(apb_resetn),
+    .apb_psel(apb_psel), .apb_penable(apb_penable),
+    .apb_pwrite(apb_pwrite), .apb_paddr(apb_paddr),
+    .apb_pwdata(apb_pwdata), .apb_prdata(apb_prdata),
+    .apb_pready(apb_pready), .usb_clk(usb_clk),
+    .usb_resetn(usb_resetn), .cfg_awaddr(cfg_awaddr),
+    .cfg_awvalid(cfg_awvalid), .cfg_awready(cfg_awready),
+    .cfg_wdata(cfg_wdata), .cfg_wstrb(cfg_wstrb),
+    .cfg_wvalid(cfg_wvalid), .cfg_wready(cfg_wready),
+    .cfg_bresp(cfg_bresp), .cfg_bvalid(cfg_bvalid),
+    .cfg_bready(cfg_bready), .cfg_araddr(cfg_araddr),
+    .cfg_arvalid(cfg_arvalid), .cfg_arready(cfg_arready),
+    .cfg_rdata(cfg_rdata), .cfg_rresp(cfg_rresp),
+    .cfg_rvalid(cfg_rvalid), .cfg_rready(cfg_rready)
+);
+
+always @(posedge usb_clk) begin
+    if (cfg_awvalid && cfg_awready) begin
+        accepted_awaddr <= cfg_awaddr;
+        aw_seen <= 1'b1;
+    end
+    if (cfg_wvalid && cfg_wready) begin
+        register_file[accepted_awaddr[5:2]] <= cfg_wdata;
+        aw_seen <= 1'b0;
+        cfg_bvalid <= 1'b1;
+    end else if (cfg_bvalid && cfg_bready) begin
+        cfg_bvalid <= 1'b0;
+    end
+
+    if (cfg_arvalid && cfg_arready) begin
+        cfg_rdata <= register_file[cfg_araddr[5:2]];
+        cfg_rvalid <= 1'b1;
+    end else if (cfg_rvalid && cfg_rready) begin
+        cfg_rvalid <= 1'b0;
+    end
+end
+
+task apb_write;
+    input [19:0] address;
+    input [31:0] data;
+    begin
+        @(posedge apb_clk);
+        apb_psel <= 1'b1;
+        apb_pwrite <= 1'b1;
+        apb_paddr <= address;
+        apb_pwdata <= data;
+        @(posedge apb_clk);
+        apb_penable <= 1'b1;
+        while (!apb_pready)
+            @(posedge apb_clk);
+        apb_psel <= 1'b0;
+        apb_penable <= 1'b0;
+        apb_pwrite <= 1'b0;
+    end
+endtask
+
+task apb_read;
+    input [19:0] address;
+    input [31:0] expected;
+    begin
+        @(posedge apb_clk);
+        apb_psel <= 1'b1;
+        apb_pwrite <= 1'b0;
+        apb_paddr <= address;
+        @(posedge apb_clk);
+        apb_penable <= 1'b1;
+        while (!apb_pready)
+            @(posedge apb_clk);
+        if (apb_prdata !== expected) begin
+            $display("FAIL: read %08x, expected %08x", apb_prdata, expected);
+            $finish(1);
+        end
+        apb_psel <= 1'b0;
+        apb_penable <= 1'b0;
+    end
+endtask
+
+initial begin
+    for (index = 0; index < 16; index = index + 1)
+        register_file[index] = 32'b0;
+    repeat (4) @(posedge apb_clk);
+    apb_resetn <= 1'b1;
+    usb_resetn <= 1'b1;
+    apb_write(20'h0c024, 32'h00000001);
+    apb_read(20'h0c024, 32'h00000001);
+    apb_write(20'h0c010, 32'h0000000f);
+    apb_read(20'h0c010, 32'h0000000f);
+    $display("PASS: asynchronous APB/AXI-Lite write and read sequencing");
+    $finish(0);
+end
+
+initial begin
+    #20000;
+    $display("FAIL: timeout");
+    $finish(1);
+end
+
+endmodule
