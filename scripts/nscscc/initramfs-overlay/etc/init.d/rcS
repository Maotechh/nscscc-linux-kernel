#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root
export PATH

AUTORUN=
if [ -r /proc/cmdline ]; then
	for argument in $(cat /proc/cmdline); do
		case "${argument}" in
			nscscc.autorun=nscscc-demo|nscscc.autorun=nscscc-check)
				AUTORUN=${argument#nscscc.autorun=}
				;;
		esac
	done
fi

# Discard UART bytes that arrived while the kernel and startup scripts were
# running. Without this, keystrokes typed during boot are buffered by the tty
# layer and are executed by the first console shell, which can be surprising
# during a judged run.
drain_console_input()
{
	[ -e /dev/console ] || return 0
	command -v stty >/dev/null 2>&1 || return 0
	command -v dd >/dev/null 2>&1 || return 0

	stty -F /dev/console -icanon min 0 time 0 2>/dev/null || return 0
	dd if=/dev/console of=/dev/null bs=128 count=1 2>/dev/null
	stty -F /dev/console icanon min 1 time 0 2>/dev/null || true
}

mount -o remount,rw / 2>/dev/null || true
mkdir -p /dev/pts /dev/shm /run /tmp /var/log /var/run
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run 2>/dev/null || true
chmod 1777 /tmp

if [ -r /etc/hostname ]; then
	hostname "$(cat /etc/hostname)"
fi

for script in /etc/init.d/S??*; do
	[ -f "${script}" ] || continue
	"${script}" start || echo "Startup failed: ${script}"
done

if [ -n "${AUTORUN}" ]; then
	echo "NSCSCC autorun: ${AUTORUN}"
	"${AUTORUN}" || echo "NSCSCC autorun failed: ${AUTORUN}"
fi

drain_console_input

echo
cat /etc/issue
echo "Run nscscc-check for the standard demonstration checks."
